# Copy to .env and fill in. Only TMDB_API_KEY is needed for movies and series.
TZ=Europe/Berlin

# Host folder that JDownloader writes into
DOWNLOAD_DIR=/mnt/poolToshiba/Downloads

# Keep this on true until enough real downloads have been checked in the dashboard
ES_DRY_RUN=true

# https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# My JDownloader account, optional. Without it only the download folder is watched.
JD_EMAIL=
JD_PASSWORD=
JD_DEVICE=truenas

# Cloudflare tunnel token for media.truenasserver.com
TUNNEL_TOKEN=

# Only needed when JDownloader should not run as root
PUID=0
PGID=0
