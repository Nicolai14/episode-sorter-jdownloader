# Copy to .env and fill in.
TZ=Europe/Berlin

# Owner of the media files. On the TrueNAS that is smb (3000) with group root (0).
PUID=3000
PGID=0

# Folder JDownloader writes into, watched by Episode Sorter
DOWNLOAD_DIR=/mnt/SmallPool/dataGrepDataset/Downloads/JDownloader

# Dashboard port on the host. The Cloudflare tunnel points at 18080.
ES_PORT=18080
JD_PORT=5800

# Keep this on true until enough real downloads have been checked in the dashboard
ES_DRY_RUN=true

# https://www.themoviedb.org/settings/api (v3 API Key oder v4 Read Access Token)
TMDB_API_KEY=

# My JDownloader account. Also gives access to JDownloader from outside the LAN
# over my.jdownloader.org.
JD_EMAIL=
JD_PASSWORD=
JD_DEVICE=truenas

# Password for the JDownloader web UI on port 5800
JD_UI_PASSWORD=

# Only for hosts without their own cloudflared: docker compose --profile tunnel up -d
TUNNEL_TOKEN=
